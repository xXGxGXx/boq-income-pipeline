#!/bin/bash
# Pre-push hook: run privacy_scan.py before allowing push
# Install: git config core.hooksPath .githooks

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCANNER="$REPO_ROOT/scripts/privacy_scan.py"

if [[ ! -f "$SCANNER" ]]; then
  echo "ERROR: privacy_scan.py not found at $SCANNER"
  exit 1
fi

echo "Running privacy scan before push..."
python3 "$SCANNER" --tracked --baseline "$REPO_ROOT/.privacy-baseline"
SCAN_EXIT=$?

if [[ $SCAN_EXIT -ne 0 ]]; then
  echo ""
  echo "PUSH BLOCKED: privacy scan found issues."
  echo "Fix findings or update .privacy-baseline with documented reasons."
  echo "Baseline entries must include owner, reason, and expiry date."
  exit 1
fi

echo "Privacy scan clean. Push allowed."
exit 0
