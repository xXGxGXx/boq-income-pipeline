{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/recall-vault/catalog.schema.json",
  "title": "Recall Vault catalog metadata",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": {"const": 1},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "role"],
        "properties": {
          "code": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
          "role": {"enum": ["original", "plate", "loop", "note", "client", "poster", "playable"]},
          "parent": {"type": "string", "minLength": 1},
          "link": {"type": ["string", "null"]},
          "tags": {"type": "array", "items": {"type": "string"}},
          "starred": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
